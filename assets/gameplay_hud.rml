<rml>
    <head>
        <style>
            body { width: 100%; height: 100%; pointer-events: none; }
            #fps, #save-slot { position: absolute; padding: 5dp 10dp; font-family: LatoLatin;
                   font-size: 22dp; color: white; background-color: #000000B0; }
            #save-slot { top: 16dp; left: 16dp; }
            #fps { display: none; }
            #fps.top-left { top: 57dp; left: 16dp; }
            #fps.top-right { top: 16dp; right: 16dp; }
            #fps.bottom-left { bottom: 16dp; left: 16dp; }
            #fps.bottom-right { bottom: 16dp; right: 16dp; }
        </style>
    </head>
    <body>
        <div id="save-slot">Save slot 1</div>
        <div id="fps" class="top-right">FPS</div>
    </body>
</rml>
